# Copia este ficheiro para .env e preenche com os dados do teu projeto Supabase
# (Project Settings > API)

VITE_SUPABASE_URL=https://teu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=a_tua_anon_key_aqui

# Chave VAPID pública (para notificações push). Gera o par com:
#   npx web-push generate-vapid-keys
# A chave PRIVADA vai só para os secrets da Edge Function (nunca no frontend).
VITE_VAPID_PUBLIC_KEY=

# MapTiler — vê os estilos em https://cloud.maptiler.com/maps/
# (entra num mapa; o ID é o slug do URL, ex. streets-v2, bright-v2, voyager-v2, basic-v2, outdoor-v2, dataviz, winter-v2…)
# Sem key: Carto Voyager + Esri.
# VITE_MAPTILER_KEY=
# Contas que só veem Avisos no /admin (emails separados por vírgula).
# VITE_AVISOS_EMAILS=ze@exemplo.com

# Timeout de sessão admin por inactividade (minutos). Predefinição: 30.
# VITE_ADMIN_IDLE_MINUTES=30
